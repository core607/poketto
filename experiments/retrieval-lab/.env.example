LAB_DATA=/var/lib/retrieval-lab/data
LAB_PORT=38470
LAB_PYTHON=.venv/bin/python
LAB_WORKER_SOCKET=/run/retrieval-lab-executor/control.sock
LAB_SIGNING_KEY=/etc/retrieval-lab/private.pem
LAB_EXPORT_ROOT=/var/lib/retrieval-lab/pool/exports
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# Optional API base overrides. Keep keys and provider configuration server-side.
DEEPSEEK_BASE_URL=https://api.deepseek.com
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Per-million-token rates; empty means unknown. Use current provider rates.
LAB_DEEPSEEK_INPUT_USD_PER_M=
LAB_DEEPSEEK_OUTPUT_USD_PER_M=
LAB_EMBEDDING_CNY_PER_M=
LAB_RERANK_CNY_PER_M=
