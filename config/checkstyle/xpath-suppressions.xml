<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionXpathFilter Experimental Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2_xpath_experimental.dtd">
<!--
  Each entry exempts one named method that already exceeded 60 code lines when the gate was
  introduced. The exemption is per method, so a new long method in the same file still fails.
  Shortening a method removes its entry. New methods get none.

  File-level exemptions live in suppressions.xml, which owns FileLength and the test source sets.
-->
<suppressions>
    <suppress-xpath checks="MethodLength" files="[\\/]assets[\\/]AssetService\.java$"
                    query="//METHOD_DEF[./IDENT[@text='prepareMedia']]"/>
    <suppress-xpath checks="MethodLength" files="[\\/]executor[\\/]internal[\\/]IsolatedRepositoryExecutor\.java$"
                    query="//METHOD_DEF[./IDENT[@text='executeWithBridge']]"/>
    <suppress-xpath checks="MethodLength" files="[\\/]executor[\\/]internal[\\/]SessionMoves\.java$"
                    query="//METHOD_DEF[./IDENT[@text='prepare']]"/>
</suppressions>
