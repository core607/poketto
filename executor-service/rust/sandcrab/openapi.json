{
  "openapi": "3.1.0",
  "info": {
    "title": "Sandcrab native service",
    "version": "0.1.0",
    "description": "Isolated finite commands and persistent shell sessions over a protected Unix socket. The configured peer UID authenticates every operation. A serverId binds retries to one daemon lifetime. Session workspace and shell state last until close, expiry, command termination or daemon loss; no TCP listener or durable volume is provided."
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "HTTP transport over the configured Unix socket."
    }
  ],
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "getInfo",
        "responses": {
          "200": {
            "description": "Server epoch, capabilities and available profile limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          }
        }
      }
    },
    "/v1/openapi": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "This OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          }
        },
        "parameters": [
          {
            "name": "capability",
            "in": "query",
            "description": "Return only this capability and its referenced schemas. Prefer this bounded view for model tools.",
            "schema": {
              "enum": [
                "runs",
                "sessions",
                "volumes"
              ]
            }
          }
        ]
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "description": "An identical request ID and body reuses a run within this server epoch. Changed arguments conflict. Forgetting ends replay protection; never reuse a forgotten ID. Unknown outcomes after restart must not be silently rerun.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Run200"
          },
          "202": {
            "$ref": "#/components/responses/Run202"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/runs/{id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Run200"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          }
        }
      }
    },
    "/v1/runs/{id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "description": "Requests cancellation without claiming containment. Poll for the terminal state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Run200"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          }
        }
      }
    },
    "/v1/runs/{id}/forget": {
      "post": {
        "operationId": "forgetRun",
        "description": "Releases a terminal result and its replay identity. Running and closing records cannot be forgotten.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record released.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "forgotten"
                  ],
                  "properties": {
                    "forgotten": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "operationId": "createSession",
        "description": "Create an isolated persistent bash session. Repeating the same ID and request returns that session, including its terminal state; different arguments conflict. Poll until ready before submitting a command.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Session200"
          },
          "202": {
            "$ref": "#/components/responses/Session202"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getSession",
        "description": "Read the session state. A connection does not own the session lifetime.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Session200"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/sessions/{id}/commands": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "executeSessionCommand",
        "description": "Admit one command while ready. Commands retain shell state and files. Concurrent commands are refused. Read, cancel and forget the returned command through /v1/runs/{id}. Cancellation, timeout, output overflow or shell exit ends the whole session; it is never silently reset.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Run200"
          },
          "202": {
            "$ref": "#/components/responses/Run202"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCommand"
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/renew": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "renewSession",
        "description": "Extend a live session from the current time, within its profile TTL. Expired sessions cannot be revived.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Session200"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ttlMillis"
                ],
                "properties": {
                  "ttlMillis": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 86400000
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/close": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "closeSession",
        "description": "Stop the whole session, including background processes. Poll until closed, expired or failed. Closing means containment or cleanup is unconfirmed and admission stays held until restart.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Session200"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/forget": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "forgetSession",
        "description": "Forget a closed, expired or failed session. Retained command records are independent and must be forgotten separately. Never reuse this session ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record released.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "forgotten"
                  ],
                  "properties": {
                    "forgotten": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          }
        }
      }
    },
    "/v1/volumes": {
      "get": {
        "operationId": "listVolumes",
        "description": "List at most 100 durable records in UUID order. Concurrent changes are not a snapshot. Continue with nextAfter.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Volume page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolumePage"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          }
        }
      },
      "post": {
        "operationId": "createVolume",
        "description": "Create empty persistent storage or a reflink clone of an unattached ready volume. Same ID and normalized plan replay across daemon restarts, including failure or deletion. An unknown ID requires the current serverId. Different plans conflict. Limits may only be lowered. A clone must use the same execution UID/GID as its source. Only one storage mutation runs at a time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolumeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Volume200"
          },
          "202": {
            "$ref": "#/components/responses/Volume202"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/volumes/{id}": {
      "get": {
        "operationId": "getVolume",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Volume200"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/volumes/{id}/delete": {
      "post": {
        "operationId": "deleteVolume",
        "description": "Explicitly delete an unattached ready volume. Deletion intent is durable before data removal; deleted tombstones remain replayable. closing requires restart and reconciliation.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Volume200"
          },
          "202": {
            "$ref": "#/components/responses/Volume202"
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/volumes/{id}/forget": {
      "post": {
        "operationId": "forgetVolume",
        "description": "Forget only a deleted or failed record after its data is absent. Ends durable replay protection. Never reuse this client ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "200": {
            "description": "Record forgotten",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "forgotten"
                  ],
                  "properties": {
                    "forgotten": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "Info": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "serverId",
          "capabilities",
          "profiles",
          "storage"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "runs",
                "sessions",
                "volumes"
              ]
            }
          },
          "profiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "timeoutMillis",
                "outputLimitBytes",
                "network",
                "sessionTtlMillis"
              ],
              "properties": {
                "timeoutMillis": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                },
                "outputLimitBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "network": {
                  "const": "none"
                },
                "sessionTtlMillis": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 86400000
                }
              }
            }
          },
          "storage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "maxVolumeBytes",
              "maxVolumeInodes",
              "maxVolumes",
              "maxRecords",
              "available"
            ],
            "properties": {
              "maxVolumeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "maxVolumeInodes": {
                "type": "integer",
                "minimum": 1
              },
              "maxVolumes": {
                "type": "integer",
                "minimum": 1
              },
              "maxRecords": {
                "type": "integer",
                "minimum": 1
              },
              "available": {
                "type": "boolean",
                "description": "False requires operator reconciliation and daemon restart before mutations."
              }
            }
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "description": "Executable argv, not shell text. First item is nonempty; arguments contain no NUL. Each is at most 4096 UTF-8 bytes, all arguments at most 16384 bytes.",
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "timeoutMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 300000,
            "description": "Omit or null to use the profile. May only lower its timeout."
          },
          "outputLimitBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1048576,
            "description": "Omit or null to use the profile. Combined raw stdout/stderr byte bound; may only lower the profile limit."
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile",
          "state",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "closing",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out",
              "output_limit",
              "resource_limit"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Output"
              },
              {
                "$ref": "#/components/schemas/Failure"
              }
            ]
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "Present for commands executed in a persistent session."
          }
        }
      },
      "Output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exitCode",
          "stdout",
          "stderr",
          "truncated"
        ],
        "properties": {
          "exitCode": {
            "type": "integer"
          },
          "stdout": {
            "type": "string",
            "description": "UTF-8 text with invalid sequences replaced."
          },
          "stderr": {
            "type": "string",
            "description": "UTF-8 text with invalid sequences replaced."
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "Failure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "enum": [
              "RUN_FAILED",
              "CONTAINMENT_UNCONFIRMED"
            ]
          }
        }
      },
      "SessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "ttlMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 86400000,
            "description": "Cannot exceed the selected profile lifetime."
          },
          "volumeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Optional ready volume mounted at /workspace exclusively until confirmed session cleanup. Omit for an ephemeral workspace."
          }
        }
      },
      "SessionCommand": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Bash source, at most 16384 UTF-8 bytes, without NUL."
          },
          "timeoutMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 300000
          },
          "outputLimitBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1048576
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile",
          "state",
          "expiresAtMillis",
          "activeRunId",
          "volumeId",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "state": {
            "enum": [
              "starting",
              "ready",
              "busy",
              "stopping",
              "closed",
              "expired",
              "failed",
              "closing"
            ]
          },
          "expiresAtMillis": {
            "type": "integer",
            "description": "Wall-clock estimate of expiry; enforcement uses a monotonic deadline."
          },
          "activeRunId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "volumeId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opening or cleanup failure, including VOLUME_IN_USE, VOLUME_NOT_READY, VOLUME_PROFILE_MISMATCH or CONTAINMENT_UNCONFIRMED."
          }
        }
      },
      "VolumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "cloneFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "byteLimit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1048576,
            "multipleOf": 1024,
            "description": "XFS charged-byte quota, at most the advertised storage maximum; sparse logical lengths are not charged blocks."
          },
          "inodeLimit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 32,
            "description": "Inode quota including the managed parent and data directories, at most the advertised maximum."
          }
        }
      },
      "Volume": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "profile",
          "state",
          "code",
          "byteLimit",
          "inodeLimit",
          "cloneFrom",
          "planDigest",
          "busy",
          "attachedTo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "state": {
            "enum": [
              "creating",
              "ready",
              "deleting",
              "deleted",
              "failed",
              "closing"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "byteLimit": {
            "type": "integer"
          },
          "inodeLimit": {
            "type": "integer"
          },
          "cloneFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "planDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the normalized creation plan, excluding the transport serverId."
          },
          "busy": {
            "type": "boolean",
            "description": "Exclusively attached to a session or held as a clone source."
          },
          "attachedTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "VolumePage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "volumes",
          "nextAfter"
        ],
        "properties": {
          "volumes": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Volume"
            }
          },
          "nextAfter": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    },
    "responses": {
      "Error403": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Run200": {
        "description": "Current run state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Run"
            }
          }
        }
      },
      "Run202": {
        "description": "Current run state.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Run"
            }
          }
        }
      },
      "Error400": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error429": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "Request refused or run unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Session200": {
        "description": "Current state or retained outcome.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Session"
            }
          }
        }
      },
      "Session202": {
        "description": "Admitted; poll the returned identity.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Session"
            }
          }
        }
      },
      "Volume200": {
        "description": "Current volume state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Volume"
            }
          }
        }
      },
      "Volume202": {
        "description": "Durable operation accepted; poll the volume ID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Volume"
            }
          }
        }
      }
    }
  }
}
