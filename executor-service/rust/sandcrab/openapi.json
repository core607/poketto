{
  "openapi": "3.1.0",
  "info": {
    "title": "Sandcrab native runs",
    "version": "0.1.0",
    "description": "Finite isolated commands over a protected Unix socket. The configured peer UID authenticates every operation; this release has no TCP listener. Runs are ephemeral; a serverId binds retries to one daemon lifetime."
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "HTTP transport over the configured Unix socket."
    }
  ],
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "getInfo",
        "responses": {
          "200": {
            "description": "Server epoch, capabilities and available profile limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Info"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi": {
      "get": {
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "This OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "description": "An identical request ID and body reuses a run within this server epoch. Changed arguments conflict. Forgetting ends replay protection; never reuse a forgotten ID. Unknown outcomes after restart must not be silently rerun.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current run state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "202": {
            "description": "Current run state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current run state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{id}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "description": "Requests cancellation without claiming containment. Poll for the terminal state.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current run state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{id}/forget": {
      "post": {
        "operationId": "forgetRun",
        "description": "Releases a terminal result and its replay identity. Running and closing records cannot be forgotten.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Record released.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "forgotten"
                  ],
                  "properties": {
                    "forgotten": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request refused or run unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "Info": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "serverId",
          "capabilities",
          "profiles"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "const": "runs"
            }
          },
          "profiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "timeoutMillis",
                "outputLimitBytes",
                "network"
              ],
              "properties": {
                "timeoutMillis": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                },
                "outputLimitBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                "network": {
                  "const": "none"
                }
              }
            }
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "description": "Executable argv, not shell text. First item is nonempty; arguments contain no NUL. Each is at most 4096 UTF-8 bytes, all arguments at most 16384 bytes.",
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "timeoutMillis": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 300000,
            "description": "Omit or null to use the profile. May only lower its timeout."
          },
          "outputLimitBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1048576,
            "description": "Omit or null to use the profile. Combined raw stdout/stderr byte bound; may only lower the profile limit."
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "serverId",
          "profile",
          "state",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "serverId": {
            "type": "string",
            "format": "uuid"
          },
          "profile": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "closing",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out",
              "output_limit",
              "resource_limit"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Output"
              },
              {
                "$ref": "#/components/schemas/Failure"
              }
            ]
          }
        }
      },
      "Output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exitCode",
          "stdout",
          "stderr",
          "truncated"
        ],
        "properties": {
          "exitCode": {
            "type": "integer"
          },
          "stdout": {
            "type": "string",
            "description": "UTF-8 text with invalid sequences replaced."
          },
          "stderr": {
            "type": "string",
            "description": "UTF-8 text with invalid sequences replaced."
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "Failure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "enum": [
              "RUN_FAILED",
              "CONTAINMENT_UNCONFIRMED"
            ]
          }
        }
      }
    }
  }
}
