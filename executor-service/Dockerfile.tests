FROM rust:1.99.1-alpine@sha256:557a94c82b485a14b569120e00867267108c734efe33f10cc31ca0cd5dd1eca9 AS rust-build
WORKDIR /source
COPY rust/ ./
RUN cargo build --locked --release --target x86_64-unknown-linux-musl

FROM rust-build AS rust-check
RUN cargo tree --locked --package sandcrab --edges normal --prefix none > /tmp/native-dependencies \
    && ! grep -E '^(sandcrab-daemon|poketto(-[a-z]+)?) v' /tmp/native-dependencies
RUN rustup component add rustfmt clippy \
    && cargo fmt --all --check \
    && cargo clippy --locked --all-targets --target x86_64-unknown-linux-musl -- -D warnings \
    && cargo clippy --locked --all-targets --all-features --target x86_64-unknown-linux-musl -- -D warnings \
    && cargo test --locked --all-features --target x86_64-unknown-linux-musl

FROM rust-build AS supervisor-fixture
RUN cargo build --locked --release --target x86_64-unknown-linux-musl \
    --package poketto-supervisor --features fixture --bin poketto-supervisor-fixture

FROM scratch AS binaries
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/sandcrab /sandcrab
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto /poketto
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-shell /poketto-shell
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-syncfs /poketto-syncfs
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-supervisor /poketto-supervisor
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-launch /poketto-launch

FROM scratch AS fixture-binary
COPY --from=supervisor-fixture /source/target/x86_64-unknown-linux-musl/release/poketto-supervisor-fixture /poketto-supervisor-fixture

# Official Python 3.12.14 slim-bookworm manifest, verified from Docker Hub.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
COPY requirements.txt /suite/requirements.txt
RUN python -m venv /venv && /venv/bin/python -I -m pip --isolated --require-virtualenv \
    --disable-pip-version-check install --no-deps --only-binary=:all: \
    --index-url https://pypi.org/simple --timeout 30 --retries 2 -r /suite/requirements.txt
# The build context is the Gradle-staged suite (stageExecutorServiceTests), so it holds only suite files.
COPY . /suite/
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/sandcrab /suite/bin/sandcrab
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto /suite/bin/poketto
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-shell /suite/bin/poketto-shell
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-syncfs /suite/bin/poketto-syncfs
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-supervisor /suite/poketto-supervisor
COPY --from=rust-build /source/target/x86_64-unknown-linux-musl/release/poketto-launch /suite/poketto-launch
COPY --from=supervisor-fixture /source/target/x86_64-unknown-linux-musl/release/poketto-supervisor-fixture /suite/poketto-supervisor-fixture
USER 65534:65534
ENTRYPOINT ["/venv/bin/python", "-I", "/suite/run_tests.py", "--suite", "--report", "/reports/TEST-executor-service.xml"]
