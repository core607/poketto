{
  "runtimeRoot": "/run/poketto-executor",
  "exportRoot": "/var/lib/poketto/executor-exports",
  "socketPath": "/run/poketto-executor/control.sock",
  "publicKey": "/etc/poketto-executor/public.pem",
  "toolsRoot": "/opt/poketto-executor/tools",
  "launcher": "/opt/poketto-executor/launcher.py",
  "execUser": "poketto-exec",
  "appUid": 1001,
  "appGid": 1001,
  "unitPrefix": "poketto-exec-worker-",
  "supervisorUnit": "poketto-executor.service",
  "leaseSeconds": 15,
  "renewAfterSeconds": 5,
  "maxRequests": 4096,
  "maxConnections": 32,
  "maxExecutionsPerSession": 1000,
  "maxSessions": 2,
  "maxBundleBytes": 134217728,
  "diskBytes": 536870912,
  "diskInodes": 32768,
  "temporaryBytes": 8388608,
  "temporaryInodes": 1024,
  "memoryBytes": 536870912,
  "tasksMax": 64,
  "cpuQuotaPercent": 100,
  "maxTimeoutMillis": 60000,
  "initTimeoutMillis": 60000
}
