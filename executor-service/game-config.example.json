{
  "runtimeRoot": "/run/poketto-games",
  "socketPath": "/run/poketto-games/control.sock",
  "publicKey": "/etc/poketto-games/public.pem",
  "toolsRoot": "/opt/poketto-executor/tools",
  "launcher": "/opt/poketto-games/launcher.py",
  "execUser": "poketto-game",
  "repositoryExecUser": "poketto-exec",
  "repositoryRuntimeRoot": "/run/poketto-executor",
  "repositoryResourceSlice": "poketto-executor.slice",
  "appUid": 1001,
  "appGid": 1001,
  "unitPrefix": "poketto-game-worker-",
  "supervisorUnit": "poketto-games.service",
