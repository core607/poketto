[Unit]
Description=Poketto isolated execution resource supervisor
After=local-fs.target

[Service]
Type=simple
User=root
Slice=poketto-executor.slice
UMask=0077
OOMScoreAdjust=-900
OOMPolicy=stop
ExecStart=/opt/poketto-executor/poketto-supervisor --config /etc/poketto-executor/config.json
ExecStopPost=/opt/poketto-executor/poketto-supervisor --config /etc/poketto-executor/config.json --cleanup
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=multi-user.target
