# Copy to .env beside compose.yaml on the production host, then fill in every value.
# deploy.sh refuses to run while a required value is missing. Keep the file mode 600.
# Values are literal single-line text after the first '='; do not add shell quoting or escapes.

# Application image. deploy.sh records the image it deployed here once it is healthy and
# verifies the revision label. Registry path: ghcr.io/core607/poketto@sha256:<digest>.
# Transfer path: the tag loaded from the docker-save archive, ghcr.io/core607/poketto:sha-<commit>.
# When a deployment replaces these pins, the previous ones are saved to .env.previous beside
# this file; pass them as --app-image, --app-revision, and --db-image to redeploy that version.
POKETTO_APP_IMAGE=
POKETTO_APP_REVISION=

# Official PostgreSQL 17, pinned by digest. Change only with a deliberate upgrade.
POKETTO_DB_IMAGE=postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0

# Database. Generate the password once, for example: openssl rand -base64 30
POSTGRES_DB=poketto
POSTGRES_USER=poketto
POSTGRES_PASSWORD=

# Remote repository authority for the default workspace: a private HTTPS repository and a
# credential scoped to it. Never commit these values anywhere.
POKETTO_REPOSITORY_REMOTE_URI=
POKETTO_REPOSITORY_USERNAME=
POKETTO_REPOSITORY_PASSWORD=

# Persistent host directories. The application directory must be owned by uid 10001.
POKETTO_DATA_DIR_HOST=/srv/poketto/data
POKETTO_DB_DIR_HOST=/srv/poketto/db

# Optional. The application listens on the loopback interface by default; a reverse proxy
# terminates TLS and forwards to it.
#POKETTO_HTTP_BIND=127.0.0.1
#POKETTO_HTTP_PORT=8080
#POKETTO_APP_MEMORY=1536m
#POKETTO_DB_MEMORY=512m
#POKETTO_HEALTH_TIMEOUT=180
#POKETTO_MIN_FREE_MB=2048
