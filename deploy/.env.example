# Copy to .env beside compose.yaml on the production host, then fill in every value.
# deploy.sh refuses to run while a required value is missing. Keep the file mode 600.
# Values are literal single-line text after the first '='; do not add shell quoting or escapes.

# Application image. deploy.sh records the image it deployed here once it is healthy and
# verifies the revision label. Registry path: ghcr.io/core607/poketto@sha256:<digest>.
# Transfer path: the tag loaded from the docker-save archive, ghcr.io/core607/poketto:sha-<commit>.
# When a deployment replaces these pins, the previous ones are saved to .env.previous beside
# this file; pass them as --app-image, --app-revision, --frontend-image, --db-image, and --gateway-image
# to redeploy that version.
POKETTO_APP_IMAGE=
POKETTO_APP_REVISION=
# Frontend must carry the same source revision; its registry digest is independent.
POKETTO_FRONTEND_IMAGE=

# Official PostgreSQL 17, pinned by digest. Change only with a deliberate upgrade.
POKETTO_DB_IMAGE=postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0

# Immutable gateway; Docker Hub access or this cached digest is needed even with GHCR transfer.
POKETTO_GATEWAY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

# Domain and DNS remain private operator configuration. DNS must point at this host, and ports
# 80/443 must be reachable for automatic HTTPS. A fresh random initialization token closes
# permanently after the first owner is created; keeping it here cannot reopen initialization.
POKETTO_PUBLIC_DOMAIN=
POKETTO_AUTH_INITIALIZATION_TOKEN=

# Choose an unused RFC1918 IPv4 subnet with at least 16 addresses (/28 or larger)
# and a strict dynamic subpool with at least eight (/29 or larger).
# The fixed Caddy address must be outside the dynamic pool.
# Example only: 172.29.230.0/24, 172.29.230.128/25, and 172.29.230.10.
# Reserve the first usable address for Docker's bridge. Only this gateway /32 is trusted;
# direct app connections, including host loopback and other containers, cannot supply XFF.
POKETTO_NETWORK_SUBNET=
POKETTO_NETWORK_DYNAMIC_RANGE=
POKETTO_GATEWAY_INTERNAL_IP=

# Database. Generate the password once, for example: openssl rand -base64 30
POSTGRES_DB=poketto
POSTGRES_USER=poketto
POSTGRES_PASSWORD=

# Remote repository authority for the default workspace: a private HTTPS repository and a
# credential scoped to it. Never commit these values anywhere.
POKETTO_REPOSITORY_REMOTE_URI=
POKETTO_REPOSITORY_USERNAME=
POKETTO_REPOSITORY_PASSWORD=

# Persistent host directories. The application directory must be owned by uid 10001.
POKETTO_DATA_DIR_HOST=/srv/poketto/data
POKETTO_DB_DIR_HOST=/srv/poketto/db
# Caddy certificate state must be separate and owned by uid 10002.
POKETTO_GATEWAY_DIR_HOST=/srv/poketto/gateway

# The host worker is installed separately; enabling it checks its prerequisites and includes
# compose.executor.yaml. Rootful Linux Docker without uid remapping is required. The host
# worker appUid/appGid must match the Spring uid/gid (10001), with execUser outside that group.
POKETTO_EXECUTOR_ENABLED=false
#POKETTO_EXECUTOR_RUNTIME_DIR_HOST=/run/poketto-executor
#POKETTO_EXECUTOR_STAGING_DIR_HOST=/var/lib/poketto/executor-exports
#POKETTO_EXECUTOR_SIGNING_KEY_HOST=/etc/poketto/executor-private.pem
# Keep application admission/export bounds at or below the worker's receiving bounds.
# These match the worker example; production values still require corpus/host measurements.
#POKETTO_EXECUTOR_MAX_SESSIONS=2
#POKETTO_EXECUTOR_OPEN_TIMEOUT_SECONDS=60
#POKETTO_EXECUTOR_CLOSE_TIMEOUT_SECONDS=15
#POKETTO_EXECUTOR_MAX_BUNDLE_BYTES=134217728
#POKETTO_EXECUTOR_EXPORT_TIMEOUT_SECONDS=30

# Optional resource limits are bounded starting values, not a measured production profile.
# The Spring health port is bound only to host loopback; Caddy owns public HTTPS.
#POKETTO_HTTP_PORT=8080
#POKETTO_APP_MEMORY=1536m
#POKETTO_DB_MEMORY=512m
#POKETTO_FRONTEND_MEMORY=384m
#POKETTO_GATEWAY_MEMORY=128m
#POKETTO_APP_CPUS=1.0
#POKETTO_DB_CPUS=0.75
#POKETTO_FRONTEND_CPUS=0.75
#POKETTO_GATEWAY_CPUS=0.5
#POKETTO_ASSETS_CACHE_MAX_BYTES=134217728
#POKETTO_ASSETS_MAX_GRANTS=2048
#POKETTO_HEALTH_TIMEOUT=180
#POKETTO_MIN_FREE_MB=2048
