{
    admin off
}

{$POKETTO_PUBLIC_DOMAIN} {
    # Spring records what reaches it; without this, a request refused or served by the gateway
    # itself left no trace at all. Caddy writes JSON to stderr, which the container log driver
    # carries to the same journal as everything else.
    #
    # An image address carries its own authorization, and the application removes that segment
    # from its records for exactly that reason. Recording the request line here would hand the
    # grant back to every reader of the journal, so these requests are left to the application,
    # which already records them with the segment collapsed. Credential headers are dropped for
    # the same reason: a session cookie or bearer token is the credential itself.
    @grant path /api/public/assets/* /api/admin/workspaces/*/assets/images/*
    log_skip @grant

    log {
        output stderr
        format filter {
            wrap json
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Set-Cookie delete
                resp_headers>Set-Cookie delete
            }
        }
    }

    @management path /actuator /actuator/*
    handle @management {
        respond 404
    }
    @business path /api /api/* /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server
    handle @business {
        reverse_proxy app:8080 {
            header_up -X-Forwarded-Port
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
}

http://:8081 {
    bind 127.0.0.1
    respond /healthz 200
}
