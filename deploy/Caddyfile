{
    admin off

    # Caddy keeps two logs. The site's access log is filtered below, but the process log, which
    # carries reverse-proxy and TLS failures, is a separate logger and was recording the whole
    # request object: query string, image grant and headers, unfiltered. That happens exactly
    # during a redeployment, when the application is briefly unreachable, which is the window
    # this work most wants recorded. Filtering the default logger covers it.
    #
    # The address is dropped rather than rewritten: a single field takes a single filter, and no
    # one expression both strips a query and collapses a grant. The access log still records the
    # route and status of the same request, except for the image addresses it skips, which appear
    # in the application's own records instead.
    log {
        output stderr
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Set-Cookie delete
                request>headers>Referer delete
            }
        }
    }
}

{$POKETTO_PUBLIC_DOMAIN} {
    # Spring records what reaches it; without this, a request refused or served by the gateway
    # itself left no trace at all. Caddy writes JSON to stderr, which the container log driver
    # carries to the same journal as everything else.
    #
    # Two parts of a request line are credentials or private material rather than routing.
    #
    # A query string carries repository paths: a member downloading their own file passes it as a
    # parameter, so an unfiltered access log would accumulate the shape of their private tree. It
    # is removed from every record.
    #
    # An image address carries its own authorization in its path, and the application removes that
    # segment from its records for exactly that reason. A single field takes a single filter, so
    # these requests are left to the application, which already records them with the segment
    # collapsed. The cost is that a gateway-level failure on an image request appears nowhere.
    #
    # Credential headers go for the same reason: a session cookie or bearer token is the
    # credential itself. The referring address goes with them: an administration page puts the
    # open document's path in its own address, and a same-origin request carries that address
    # whole, so the path removed from the request line arrives again in another field. The
    # referrer policy already keeps it from leaving this origin, which makes these records its
    # only exposure.
    @grant path /api/public/assets/* /api/admin/workspaces/*/assets/images/*
    log_skip @grant

    log {
        output stderr
        format filter {
            wrap json
            fields {
                request>uri regexp "\?.*$" ""
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>Set-Cookie delete
                request>headers>Referer delete
                resp_headers>Set-Cookie delete
            }
        }
    }

    @management path /actuator /actuator/*
    handle @management {
        respond 404
    }
    @business path /api /api/* /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server
    handle @business {
        reverse_proxy app:8080 {
            header_up -X-Forwarded-Port
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
}

http://:8081 {
    bind 127.0.0.1
    respond /healthz 200
}
